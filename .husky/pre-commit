echo "🔍 Запуск pre-commit проверок..."

# 1. Запускаем lint-staged для автоисправления измененных файлов
echo "📝 Автоисправление измененных файлов..."
npx lint-staged

# 2. Полный линт пропущен (warnings не блокируют коммит, проверяются только измененные файлы через lint-staged)

# 3. Запускаем все тесты
echo "🧪 Запуск всех тестов..."
npm test -- --passWithNoTests

# 4. Проверяем полную сборку приложения (включая проверку БД)
echo "🏗️  Полная проверка сборки приложения..."
npm run build:full

echo "✅ Все проверки пройдены! Коммит разрешен."


